# ============================================================================
# RESTAURANT MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# Copy this file to .env and update with your local values
# ============================================================================

# DATABASE CONFIGURATION
DATABASE_URL=postgresql://postgres:password@localhost:5432/rms_backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rms_backend
DB_USER=postgres
DB_PASSWORD=kezaoscar46

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# JWT CONFIGURATION
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRE=7d

# CORS CONFIGURATION
CORS_ORIGIN=http://localhost:3000

# PAYMENT GATEWAY (Optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
ASMPAY_API_KEY=your_asmpay_key_here
ASMPAY_API_URL=https://api.asmpay.com

# LOGGING
LOG_LEVEL=debug

# EMAIL (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

